#version 460
#extension GL_EXT_nonuniform_qualifier : enable
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set=0, binding = 1, r32f) uniform image3D tensors[];
layout(set=0, binding = 3) buffer SSBO {
    float data[];
} buffers[];

layout(push_constant) uniform PushConstants {
    uint prev_act; // image3D index: input activations [in_ch,  in_h,  in_w]
    uint next_grad_act; // image3D index: upstream gradient [out_ch, out_h, out_w]
    uint grad_weights; // buffer index: weight gradient [out_ch, in_ch, kH, kW]
    uint in_ch;
    uint out_ch;
    uint in_h;
    uint in_w;
    uint out_h;
    uint out_w;
    uint kH;
    uint kW;
    uint pad;
} pc;

void main(){
    uint k = gl_GlobalInvocationID.x; // output channel
    uint c = gl_GlobalInvocationID.y; // input channel
    if(k >= pc.out_ch || c >= pc.in_ch) return;

    uint kernel_size = pc.kH * pc.kW;

    for(uint ky = 0; ky < pc.kH; ky++){
        for(uint kx = 0; kx < pc.kW; kx++){

            float sum = 0.0;

            for(uint oy = 0; oy < pc.out_h; oy++){
                int iy = int(oy + ky) - int(pc.pad);
                if(iy < 0 || iy >= int(pc.in_h)) continue;

                for(uint ox = 0; ox < pc.out_w; ox++){
                    int ix = int(ox + kx) - int(pc.pad);
                    if(ix < 0 || ix >= int(pc.in_w)) continue;

                    float g = imageLoad(tensors[nonuniformEXT(pc.next_grad_act)], ivec3(ox, oy, k)).r;
                    float a = imageLoad(tensors[nonuniformEXT(pc.prev_act)],       ivec3(ix, iy, c)).r;

                    sum += g * a;
                }
            }

            uint w_idx = k * (pc.in_ch * kernel_size)
                       + c * kernel_size
                       + ky * pc.kW
                       + kx;
            buffers[nonuniformEXT(pc.grad_weights)].data[w_idx] = sum;
        }
    }
}